// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prefixed underlying DB object names (ra_*) -- this Postgres instance is
// shared with the old `reyse` app's ~50-model schema (same project, same
// database, not yet fully decommissioned). "EnquiryStatus" already exists
// there, confirmed the hard way (P3005 baseline attempt collided with it
// live in production). Prisma-level names stay clean (Enquiry,
// EnquiryChannel, EnquiryStatus) via @@map -- only the real SQL names are
// namespaced, so nothing above the schema file needs to know or care.
enum EnquiryChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  MANUAL

  @@map("ra_enquiry_channel")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  WON
  LOST

  @@map("ra_enquiry_status")
}

model Enquiry {
  id           String  @id @default(cuid())
  fullName     String
  email        String
  phone        String
  businessName String
  message      String?

  channel EnquiryChannel @default(WEBSITE)
  status  EnquiryStatus  @default(NEW)
  notes   String?

  // Marked true for enquiries created via "Add test enquiry" -- excluded
  // from real stats and clearly flagged in the UI, never mixed in with
  // genuine leads.
  isTest Boolean @default(false)

  // Soft delete only. "Delete" moves an enquiry to Trash by setting this;
  // nothing is ever hard-deleted from the UI, so an accidental delete is
  // always recoverable. A scheduled hard-purge of old trash is a future
  // decision, not something this builds silently.
  deletedAt DateTime?

  // Set the first time status moves away from NEW -- this is what the
  // response-time stat is measured from, separate from createdAt so a
  // status changed back to NEW later doesn't corrupt the metric.
  firstRespondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([channel])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("ra_enquiry")
}

// Live Chat -- reyse.co.uk's Claude-powered widget persists every
// conversation here (Reyse-Website's api/chat.ts calls the public API
// below). Not just enquiries: full transcripts, including conversations
// that never convert, since "most-asked questions" and real usage
// analytics need the whole picture, not just the leads.
enum ChatRole {
  USER
  ASSISTANT
  OPERATOR

  @@map("ra_chat_role")
}

enum ChatConversationStatus {
  ACTIVE
  CLOSED

  @@map("ra_chat_conversation_status")
}

// Broad, deterministic keyword buckets for "most-asked questions" --
// applied to a conversation's opening message. Not NLP/ML clustering
// (no infra for that, and it would need real training data this product
// doesn't have yet); a handful of honest keyword buckets is a real,
// truthful answer to "what do visitors actually ask about" without
// pretending to more sophistication than exists.
enum ChatTopic {
  PRICING
  HOW_IT_WORKS
  GETTING_STARTED
  OTHER

  @@map("ra_chat_topic")
}

model ChatConversation {
  id String @id @default(cuid())

  // Client-generated id stored in the visitor's sessionStorage -- ties every
  // message in one browser session to the same conversation without any
  // account/login on the visitor's side.
  visitorId String

  status ChatConversationStatus @default(ACTIVE)
  topic  ChatTopic              @default(OTHER)

  // Set true the moment the AI's send_enquiry tool actually fires for this
  // conversation -- this is what the conversion-rate stat is measured
  // against, distinct from whether Morgan has since actioned it.
  convertedToEnquiry Boolean @default(false)

  notes String?

  // Soft delete only, same pattern as Enquiry -- never hard-deleted from
  // the UI, always recoverable via restore.
  deletedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  messages ChatMessage[]

  @@index([status])
  @@index([deletedAt])
  @@index([lastMessageAt])
  @@index([visitorId])
  @@map("ra_chat_conversation")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])

  role    ChatRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("ra_chat_message")
}

// Single-row table -- the grounding facts (pricing, features, how it
// works) the chat's system prompt is built from. Editable from the admin
// UI instead of only in code, so pricing changes don't need a deploy.
// Reyse-Website's api/chat.ts fetches the current content on every
// request (with a hardcoded fallback if reyse-app is unreachable).
model ChatKnowledge {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("ra_chat_knowledge")
}

// Social Media Automation -- generates and posts single/carousel content to
// Instagram and Facebook, promoting Reyse itself (not a per-client feature).
// Prior art: the old `reyse` backend had THREE unreconciled systems for this
// (single-post, carousel, story), each with its own image source, storage
// backend, and even a different env var for the same Instagram account --
// explicitly judged "not good enough" and the reason this is one unified
// pipeline instead of three. Shares ChatKnowledge above as its grounding
// facts, same as the live chat widget, so pricing/feature claims can't drift
// between the two surfaces.
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK

  @@map("ra_social_platform")
}

enum SocialPostType {
  SINGLE
  CAROUSEL

  @@map("ra_social_post_type")
}

enum SocialPostStatus {
  DRAFT // generated, sitting in the review queue
  SCHEDULED // approved (or auto-approved in AUTONOMOUS mode), waiting for scheduledFor
  PUBLISHED
  FAILED
  REJECTED

  @@map("ra_social_post_status")
}

enum SocialPillar {
  PROMOTION
  EDUCATION
  SOCIAL_PROOF
  BEHIND_THE_SCENES
  NEWS
  TIPS

  @@map("ra_social_pillar")
}

enum SocialImageSource {
  AI_PHOTO
  TEMPLATE

  @@map("ra_social_image_source")
}

enum SocialPublishingMode {
  REVIEW_QUEUE
  AUTONOMOUS

  @@map("ra_social_publishing_mode")
}

// Two rows for a cross-posted pair (one INSTAGRAM, one FACEBOOK) share a
// groupId so the admin UI can present them as one card -- independent rows
// so each platform's publish/failure/edit state tracks separately, and
// Instagram going down doesn't block Facebook or vice versa.
model SocialPost {
  id      String @id @default(cuid())
  groupId String

  platform SocialPlatform
  type     SocialPostType
  pillar   SocialPillar
  status   SocialPostStatus @default(DRAFT)

  caption  String
  hashtags String[]

  scheduledFor DateTime?
  publishedAt  DateTime?

  externalPostId    String?
  externalPermalink String?
  failureReason     String?
  rejectionReason   String?

  reviewedAt DateTime?
  reviewedBy String?

  // Morgan's own quality rating/notes on this specific post, independent of
  // its publish status -- lets him review the whole history (not just the
  // pending queue) and build up a record of what's actually working, not
  // just what got approved. 1-10, nullable since most posts start unrated.
  rating       Int?
  ratingNote   String?
  ratedAt      DateTime?

  // Soft delete only -- same pattern as every other feature this session,
  // never hard-deleted from the UI, always recoverable via restore.
  deletedAt DateTime?

  images SocialPostImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([groupId])
  @@index([deletedAt])
  @@index([scheduledFor])
  @@index([platform])
  @@map("ra_social_post")
}

model SocialPostImage {
  id     String     @id @default(cuid())
  postId String
  post   SocialPost @relation(fields: [postId], references: [id])

  order   Int
  assetId String
  asset   SocialAsset @relation(fields: [assetId], references: [id])
  altText String

  source SocialImageSource

  @@index([postId])
  @@map("ra_social_post_image")
}

// Image bytes stored directly in Postgres and served via a public (no-auth)
// route -- Meta's Graph API fetches images by URL, so whatever we use has to
// be reachable over plain HTTPS with no secret. Keeping this in our own DB
// avoids a second storage dependency (Azure Blob, S3, ...) that could be
// misconfigured with nobody around to fix it.
model SocialAsset {
  id       String @id @default(cuid())
  data     Bytes
  mimeType String
  width    Int
  height   Int

  images SocialPostImage[]

  createdAt DateTime @default(now())

  @@map("ra_social_asset")
}

// Singleton settings row -- publishing mode is the one safety-critical
// control. REVIEW_QUEUE (default): nothing goes live without a human
// approving it in the admin UI. AUTONOMOUS: approved-by-default, published
// as soon as scheduledFor arrives. Defaults to REVIEW_QUEUE so nothing posts
// unsupervised before the quality has actually been seen.
model SocialSettings {
  id String @id @default("singleton")

  publishingMode SocialPublishingMode @default(REVIEW_QUEUE)
  enabled        Boolean              @default(true)

  postsPerWeekInstagram Int @default(3)
  postsPerWeekFacebook  Int @default(3)

  lastGeneratedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("ra_social_settings")
}

// Singleton settings row for Talk to Rey's spoken voice. Kokoro-82M (the
// DeepInfra TTS model this feature already uses) has no pitch/tone knobs --
// the only real controls are which built-in voice to use, an optional
// equal-weight blend of two voices (confirmed-working "voiceA+voiceB"
// syntax), and speaking speed. blendVoice is null for a single voice.
model TalkSettings {
  id String @id @default("singleton")

  voice      String  @default("bm_lewis")
  blendVoice String?
  speed      Float   @default(1.0)

  updatedAt DateTime @updatedAt

  @@map("ra_talk_settings")
}

// Generic AI/paid-API cost tracking, reused across features -- the standing
// Feature Build Process requires every cost-incurring feature to log here;
// this is the first feature to actually build the table (flagged as a gap
// since the live chat widget shipped). Modelled on the old backend's
// AiUsageLog, minus the mess: no per-tenant field (single-tenant product),
// one shared table for every feature rather than one per system.
model AiUsageLog {
  id      String @id @default(cuid())
  feature String
  model   String

  inputTokens  Int?
  outputTokens Int?
  imageCount   Int?
  costUsd      Float?

  // Nullable -- set by DM Automation ("dm-reply", see below), reyse-app's
  // first multi-tenant feature. Every other feature's rows stay null
  // (Reyse's own single-tenant usage, no client to attribute it to).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([clientId, createdAt])
  @@map("ra_ai_usage_log")
}

enum BackgroundTaskStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@map("ra_talk_background_task_status")
}

// A build/research/writing task Talk to Rey queues instead of doing inline,
// so a live voice conversation isn't blocked waiting on multi-step work.
// Runs as its own Agent SDK session (own sessionId, scoped to the vault
// checkout same as the live conversation) via Next's after(). reportedAt
// tracks whether a finished task has already been mentioned back to Morgan
// on a later voice turn, so it's surfaced exactly once.
model BackgroundTask {
  id            String               @id @default(cuid())
  prompt        String
  status        BackgroundTaskStatus @default(PENDING)
  sessionId     String?
  resultSummary String?
  error         String?

  reportedAt  DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([reportedAt])
  @@map("ra_talk_background_task")
}

// Email Assistant -- full inbox access to Morgan's own Gmail (not a
// per-client feature). Rey reads the inbox, organises it into folders
// (Gmail labels), and drafts replies -- never sends. Phase 1 (this build):
// connect, read, organise. Drafts and a chat panel are later phases.
//
// Single row -- one inbox, one connection. The refresh token is encrypted
// at rest (AES-256-GCM, see src/lib/mail/crypto.ts) rather than stored
// plain, same "no secrets sitting in the open" instinct as everywhere else
// in this codebase. The OAuth client this token belongs to is a dedicated
// one ("Reyse Mail Assistant", Internal audience, Workspace-confirmed so
// tokens don't expire), kept separate from the client that handles
// dashboard sign-in so nothing here can affect login.
model MailAccount {
  id    String @id @default("singleton")
  email String

  refreshTokenCiphertext String
  refreshTokenIv         String
  refreshTokenAuthTag    String

  // Gmail's incremental-sync cursor (Users.history.list) -- null until the
  // first sync, after which every tick only asks Gmail "what changed since
  // this ID" instead of re-scanning the inbox.
  historyId String?

  connectedAt   DateTime  @default(now())
  lastSyncedAt  DateTime?
  lastSyncError String?

  // Tracks the one-time (or Morgan-triggered re-run) sweep through the
  // *entire* existing mailbox -- distinct from the ongoing 5-minute job
  // above, which only ever looks at new arrivals. Starts IN_PROGRESS the
  // moment the account connects. backfillPageToken resumes the sweep
  // across ticks (Gmail's messages.list pagination), since a real mailbox
  // is too large to process in one tick.
  backfillStatus    MailBackfillStatus @default(NOT_STARTED)
  backfillPageToken String?

  @@map("ra_mail_account")
}

enum MailBackfillStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE

  @@map("ra_mail_backfill_status")
}

enum MailActivityAction {
  MESSAGE_FILED // a message got its first folder(s)
  MESSAGE_MOVED // a message's folder(s) changed -- some removed, some added
  LABEL_CREATED
  LABEL_RENAMED
  LABEL_DELETED
  SYNC_ERROR

  @@map("ra_mail_activity_action")
}

// Every organising action Rey takes gets logged here -- the activity feed
// on the Mail page reads straight from this table. This is the paper trail
// that makes "full trust, no per-action confirmation" (Morgan's call, 30
// July 2026) safe to grant: nothing is a black box after the fact, even
// though nothing needs approval before the fact.
model MailActivityLog {
  id      String             @id @default(cuid())
  action  MailActivityAction
  // Human-readable one-liner for the feed, e.g. "Filed 'Booking.com
  // payout' under Finance" or "Created folder Client Enquiries".
  summary String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ra_mail_activity_log")
}

// ---------------------------------------------------------------------
// DM Automation -- Instagram/Facebook DM auto-replies for Reyse's actual
// paying clients (independent holiday-let hosts), not Reyse itself. This
// is reyse-app's first genuinely multi-tenant feature: every model above
// this line is single-tenant, built only for Reyse's own accounts/inbox.
// Morgan manages every client himself through this dashboard -- there is
// no client-facing login anywhere in this feature, by deliberate choice.
//
// Prior art: an old, single-tenant, hardcoded Instagram DM bot existed in
// the abandoned `reyse` repo (Morgan's own account only, no client
// onboarding ever built). Its real, previously-undiagnosed failure was a
// webhook signature bug (the POST HMAC check used the GET verify-token
// instead of the actual app secret, so every inbound DM silently 401'd
// with no alert) -- see src/lib/dm/webhookAuth.ts and the scheduled
// synthetic health check in src/lib/dm/scheduler.ts, both built
// specifically so that class of bug can't ship silently again.
//
// Naming convention: generic tenant/property concepts below (Client,
// Property, PropertyKnowledgeBase, CalendarConnection, CalendarBlock,
// Booking) are named plainly, not "Dm"-prefixed, since a future WhatsApp
// Automation feature is expected to reuse this same tenant model rather
// than invent its own. Everything specific to DM mechanics (webhook
// payload shape, the 24h messaging window, echo events) is Dm-prefixed,
// since that doesn't generalize to WhatsApp's own webhook format.
enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("ra_client_status")
}

model Client {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique
  status ClientStatus @default(ACTIVE)

  // Where booking/escalation notifications go -- defaults to Morgan's own
  // address for client zero, settable per client later so a real host can
  // get their own notifications without ever needing a login.
  notificationEmail String

  // Hard per-client kill switch, checked before any AI reply is
  // generated -- independent of any single conversation's own escalation
  // state.
  aiEnabled Boolean @default(true)

  notes String?

  properties      Property[]
  metaConnections ClientMetaConnection[]
  conversations   DmConversation[]
  activityLogs    DmActivityLog[]
  aiUsageLogs     AiUsageLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("ra_client")
}

model Property {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  name     String
  location String?

  checkInTime  String?
  checkOutTime String?

  // Needed to interpret an iCal feed's all-day date blocks, and "which
  // calendar date is check-in", correctly -- an easy off-by-one-night bug
  // if this stays implicit (UTC vs the property's actual local date).
  timezone String @default("Europe/London")

  isActive Boolean @default(true)

  knowledgeBase      PropertyKnowledgeBase?
  calendarConnection CalendarConnection?
  conversations      DmConversation[]
  bookings           Booking[]
  calendarBlocks     CalendarBlock[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([deletedAt])
  @@map("ra_property")
}

// 1:1 with Property, shaped exactly like ChatKnowledge above -- one
// free-text block edited in an admin textarea, same UX, no new form
// plumbing. This is what src/lib/dm/replyEngine.ts grounds every DM reply
// in, per property rather than one shared singleton.
model PropertyKnowledgeBase {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id])

  content   String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("ra_property_knowledge_base")
}

enum ClientMetaConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  ERROR

  @@map("ra_client_meta_connection_status")
}

// One row per (Client, platform) -- Instagram now, Facebook Messenger in
// a later phase reuses this same model. Reuses the existing SocialPlatform
// enum below (INSTAGRAM/FACEBOOK already means the same thing there) --
// an enum of platform names isn't itself tenant data, so sharing it with
// the unrelated Social content-posting feature is fine.
model ClientMetaConnection {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  platform SocialPlatform

  // The Instagram-scoped business account id (or, for Facebook Messenger
  // later, the Page id) that an inbound webhook's entry[].id is matched
  // against to route the message to this client.
  externalAccountId String
  externalUsername  String?
  pageId            String?

  // AES-256-GCM, same shape as MailAccount's refresh token above -- see
  // src/lib/dm/crypto.ts. Never stored plain.
  accessTokenCiphertext String
  accessTokenIv         String
  accessTokenAuthTag    String
  tokenExpiresAt        DateTime?

  status               ClientMetaConnectionStatus @default(ACTIVE)
  lastHealthCheckAt    DateTime?
  lastHealthCheckError String?

  connectedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([clientId, platform])
  @@unique([platform, externalAccountId])
  @@index([status])
  @@map("ra_client_meta_connection")
}

enum DmConversationStatus {
  AI_ACTIVE
  ESCALATED
  HUMAN_ACTIVE
  CLOSED

  @@map("ra_dm_conversation_status")
}

// One per guest DM thread -- the direct analog of ChatConversation above,
// scoped to a Client (and, once determined, a Property) instead of being
// implicitly "Reyse's own".
model DmConversation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Nullable until determined -- a single-property client auto-binds
  // immediately; a multi-property client's conversation starts unbound
  // until resolvePropertyOrAsk() (src/lib/dm/replyEngine.ts) asks the
  // guest which property they mean.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  // Counts how many times resolvePropertyOrAsk() has asked a multi-property
  // client's guest which property they mean -- bounds the retry (ask, one
  // re-ask on an ambiguous/unmatched answer, then escalate) so a confused
  // exchange can't loop forever. Reset to 0 once a property is resolved.
  propertyDisambiguationAttempts Int @default(0)

  platform         SocialPlatform
  externalUserId   String
  externalUsername String?

  status           DmConversationStatus @default(AI_ACTIVE)
  escalatedAt      DateTime?
  escalationReason String?

  // Per-conversation override on top of Client.aiEnabled -- lets Morgan
  // silence just one thread without pausing the whole client.
  aiEnabled Boolean @default(true)

  // Enforces Meta's 24-hour messaging window in code, not only in the
  // prompt -- see src/lib/dm/replyEngine.ts.
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  messages     DmMessage[]
  bookings     Booking[]
  activityLogs DmActivityLog[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())
  deletedAt     DateTime?

  @@unique([clientId, platform, externalUserId])
  @@index([clientId, status])
  @@index([deletedAt])
  @@index([lastInboundAt])
  @@map("ra_dm_conversation")
}

// Deliberately its own enum, not a reuse of ChatRole above -- ChatRole
// belongs to Reyse's own marketing-site widget, and sharing it with
// per-client guest data would be exactly the kind of accidental coupling
// this schema otherwise goes out of its way to avoid (the same principle
// as why DM conversations don't reuse the Enquiry model -- see
// reyse-app/CLAUDE.md).
enum DmMessageRole {
  GUEST
  AI
  OPERATOR

  @@map("ra_dm_message_role")
}

model DmMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   DmConversation @relation(fields: [conversationId], references: [id])

  role    DmMessageRole
  content String

  // Meta's own message id ("mid") -- the idempotency key. Nullable-unique
  // (Postgres allows multiple NULLs) so upserting on this is what
  // survives the echo-arrives-before-write race the old repo's own
  // bug-fix commit identified and fixed.
  externalMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("ra_dm_message")
}

enum DmActivityAction {
  ESCALATED
  TAKEN_OVER_BY_OPERATOR
  RETURNED_TO_AI
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TOKEN_REAUTH_NEEDED
  WEBHOOK_HEALTH_CHECK_FAILED

  @@map("ra_dm_activity_action")
}

// Paper trail, modelled directly on MailActivityLog above.
model DmActivityLog {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  conversationId String?
  conversation   DmConversation? @relation(fields: [conversationId], references: [id])

  action  DmActivityAction
  summary String

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("ra_dm_activity_log")
}

enum CalendarSource {
  ICAL
  GOOGLE

  @@map("ra_calendar_source")
}

enum CalendarConnectionStatus {
  ACTIVE
  ERROR

  @@map("ra_calendar_connection_status")
}

// 1:1 with Property. Either an iCal feed URL (no OAuth, works with any
// platform/channel manager's standard export) or a Google Calendar
// connection -- a client picks one per property at setup (Phase 2).
model CalendarConnection {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id])

  source CalendarSource

  icalUrl String?

  googleCalendarId             String?
  googleRefreshTokenCiphertext String?
  googleRefreshTokenIv         String?
  googleRefreshTokenAuthTag    String?

  status        CalendarConnectionStatus @default(ACTIVE)
  lastSyncedAt  DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ra_calendar_connection")
}

enum CalendarBlockSource {
  ICAL_IMPORT
  GOOGLE_IMPORT
  REYSE_BOOKING

  @@map("ra_calendar_block_source")
}

// The unified "this date range is unavailable" record regardless of
// where it came from -- src/lib/dm/calendar/availability.ts only ever
// queries this table, never CalendarConnection.source, which is the
// entire point of normalizing both import sources plus Reyse's own
// bookings into one shape.
model CalendarBlock {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  source CalendarBlockSource

  // The iCal feed's own UID, the Google event id, or a synthesized
  // "reyse-booking:<bookingId>" -- always populated, which makes a
  // refresh a clean upsert-on-conflict + delete-what's-missing diff.
  externalUid String

  // Stored as UTC-midnight-of-the-property's-local-calendar-date -- a
  // deliberate convention (not an instant in time), documented here since
  // it must be read/written consistently everywhere this model is
  // touched.
  startDate DateTime
  endDate   DateTime

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, externalUid])
  @@index([propertyId, startDate, endDate])
  @@map("ra_calendar_block")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED

  @@map("ra_booking_status")
}

// A booking confirmed inside Reyse -- field names deliberately avoid any
// language implying this writes to Airbnb/Booking.com, because it can't
// (no third-party API exists for that). It blocks the dates in Reyse's
// own record (a CalendarBlock) and, for a Google-sourced property, is
// also pushed onto the client's actual Google Calendar -- see
// src/lib/dm/calendar/google.ts. Either way the host is notified, so a
// human always knows a booking happened even though nothing required
// their approval first.
model Booking {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  conversationId String?
  conversation   DmConversation? @relation(fields: [conversationId], references: [id])

  guestName    String
  guestContact String?

  startDate DateTime
  endDate   DateTime

  status BookingStatus @default(CONFIRMED)

  notes          String?
  notifiedHostAt DateTime?

  // Set only when this booking was pushed onto a client's actual Google
  // Calendar (source GOOGLE properties only) -- lets a later cancellation
  // remove the real event too, not just the internal CalendarBlock.
  googleEventId String?

  calendarBlocks CalendarBlock[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([propertyId, startDate, endDate])
  @@index([conversationId])
  @@index([deletedAt])
  @@map("ra_booking")
}

// Append-only record from the scheduled synthetic-webhook safeguard (see
// src/lib/dm/scheduler.ts) -- the automated check that exists specifically
// because the old DM system's webhook signature bug silently broke every
// inbound message with no alert, for a real stretch of time, discovered
// only by manually DMing the account. This is what would have caught it
// immediately instead.
model DmWebhookHealthCheckLog {
  id    String   @id @default(cuid())
  ranAt DateTime @default(now())
  ok    Boolean

  statusCode   Int?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([ranAt])
  @@map("ra_dm_webhook_health_check_log")
}
