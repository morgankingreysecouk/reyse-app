# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# The only email allowed to sign in
ADMIN_EMAIL=morgan.king@reyse.co.uk

# Talk to Rey -- hosted voice conversation
# Same keys voice-line already uses; reuse the same values, don't generate new ones.
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# Same subscription-based auth as voice-line (`claude setup-token`). Unlike
# voice-line's own single-purpose script, this app can have ANTHROPIC_API_KEY
# set too for other features (e.g. Instagram automation) without conflict --
# the Talk to Rey route explicitly strips that key from just its own
# subprocess so the two billing modes don't collide.
CLAUDE_CODE_OAUTH_TOKEN=
# A GitHub personal access token scoped to read reyse-vault (repo scope),
# used only at build time to clone Rey's memory into this app.
VAULT_GITHUB_TOKEN=

# Email Assistant -- Gmail access to morgan.king@reyse.co.uk
# A dedicated OAuth client ("Reyse Mail Assistant", Web application type,
# Internal audience) in the same Google Cloud project as GOOGLE_CLIENT_ID
# above, kept separate so nothing here can affect dashboard sign-in.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 32-byte key, base64-encoded, for encrypting the stored Gmail refresh
# token at rest. Generate with: openssl rand -base64 32
MAIL_TOKEN_ENCRYPTION_KEY=

# Used by Social to build absolute image URLs for Meta's Graph API, and by
# DM Automation's scheduled synthetic webhook health check to call its own
# public webhook route. Defaults to the working Railway URL if unset. NOT
# used by the Email Assistant or DM Automation's own OAuth flow -- their
# redirect URIs are derived from the actual incoming request instead, since
# a static URL here would drift the moment the app is reachable at more
# than one hostname (which it now is).
PUBLIC_BASE_URL=

# DM Automation -- Instagram/Facebook DM auto-replies, sold to holiday-let
# host clients (reyse-app's first multi-tenant feature). See the "DM
# Automation" section in CLAUDE.md for the full picture.
# Meta app credentials (Meta for Developers -> your app -> Settings -> Basic).
# Used for the per-client OAuth connect flow, the /debug_token health
# check, AND the webhook's POST signature (X-Hub-Signature-256) HMAC key.
META_APP_ID=
META_APP_SECRET=
# A value YOU choose and enter in Meta's webhook subscription config (Meta
# for Developers -> your app -> Webhooks) -- the GET challenge-response
# secret. Deliberately a DIFFERENT secret from META_APP_SECRET above:
# conflating these two was the exact bug that silently broke every inbound
# DM in the abandoned old system, so keep them visibly distinct here too.
META_WEBHOOK_VERIFY_TOKEN=
# 32-byte key, base64-encoded, for encrypting each client's Meta access
# token (and, in a later phase, Google Calendar refresh tokens) at rest.
# Deliberately its own key, not a reuse of MAIL_TOKEN_ENCRYPTION_KEY above.
# Generate with: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=
# reyse-app's first own use of Resend (every other email in this business
# is sent from the separate Reyse-Website project) -- escalation
# notifications have to originate here since this app is the one holding
# the live Meta webhook connection. https://resend.com/api-keys
RESEND_API_KEY=
